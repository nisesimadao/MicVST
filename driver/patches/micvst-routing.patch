diff --git a/Source/Main/minwavertstream.cpp b/Source/Main/minwavertstream.cpp
index a71aef3..1111111 100644
--- a/Source/Main/minwavertstream.cpp
+++ b/Source/Main/minwavertstream.cpp
@@ -6,6 +6,79 @@
 #include "minwavert.h"
 #include "minwavertstream.h"
 #define MINWAVERTSTREAM_POOLTAG 'SRWM'
+
+// MicVST private render->capture bridge.
+//
+// The MicVST app renders its processed audio to the dedicated render endpoint.
+// This driver copies those WaveRT bytes into a bounded non-paged ring buffer and
+// the capture endpoint consumes the same bytes. Both endpoints are constrained
+// by the MicVST patch to 48 kHz / stereo / 32-bit PCM, so no kernel resampler is
+// required. On overflow we drop the oldest bytes to prevent latency growth; on
+// underflow the capture stream receives silence.
+namespace
+{
+    static constexpr ULONG MICVST_BRIDGE_CAPACITY = 64 * 1024;
+    static UCHAR g_MicVSTBridge[MICVST_BRIDGE_CAPACITY] = {};
+    static KSPIN_LOCK g_MicVSTBridgeLock;
+    static volatile LONG g_MicVSTBridgeInitState = 0;
+    static ULONG g_MicVSTBridgeRead = 0;
+    static ULONG g_MicVSTBridgeWrite = 0;
+    static ULONG g_MicVSTBridgeAvailable = 0;
+
+    static VOID MicVSTBridgeEnsureInitialized()
+    {
+        if (InterlockedCompareExchange(&g_MicVSTBridgeInitState, 1, 0) == 0)
+        {
+            KeInitializeSpinLock(&g_MicVSTBridgeLock);
+            g_MicVSTBridgeRead = 0;
+            g_MicVSTBridgeWrite = 0;
+            g_MicVSTBridgeAvailable = 0;
+            KeMemoryBarrier();
+            InterlockedExchange(&g_MicVSTBridgeInitState, 2);
+        }
+    }
+
+    static VOID MicVSTBridgeReset()
+    {
+        MicVSTBridgeEnsureInitialized();
+        if (InterlockedCompareExchange(&g_MicVSTBridgeInitState, 2, 2) != 2)
+            return;
+
+        KIRQL oldIrql;
+        KeAcquireSpinLock(&g_MicVSTBridgeLock, &oldIrql);
+        g_MicVSTBridgeRead = 0;
+        g_MicVSTBridgeWrite = 0;
+        g_MicVSTBridgeAvailable = 0;
+        KeReleaseSpinLock(&g_MicVSTBridgeLock, oldIrql);
+    }
+
+    static VOID MicVSTBridgePush(_In_reads_bytes_(bytes) const UCHAR* data, _In_ ULONG bytes)
+    {
+        MicVSTBridgeEnsureInitialized();
+        if (InterlockedCompareExchange(&g_MicVSTBridgeInitState, 2, 2) != 2 || data == NULL || bytes == 0)
+            return;
+
+        // If one update is larger than the ring, keep only the newest tail.
+        if (bytes >= MICVST_BRIDGE_CAPACITY)
+        {
+            data += bytes - MICVST_BRIDGE_CAPACITY;
+            bytes = MICVST_BRIDGE_CAPACITY;
+        }
+
+        KIRQL oldIrql;
+        KeAcquireSpinLock(&g_MicVSTBridgeLock, &oldIrql);
+
+        const ULONG freeBytes = MICVST_BRIDGE_CAPACITY - g_MicVSTBridgeAvailable;
+        if (bytes > freeBytes)
+        {
+            const ULONG drop = bytes - freeBytes;
+            g_MicVSTBridgeRead = (g_MicVSTBridgeRead + drop) % MICVST_BRIDGE_CAPACITY;
+            g_MicVSTBridgeAvailable -= drop;
+        }
+
+        const ULONG first = min(bytes, MICVST_BRIDGE_CAPACITY - g_MicVSTBridgeWrite);
+        RtlCopyMemory(g_MicVSTBridge + g_MicVSTBridgeWrite, data, first);
+        if (bytes > first)
+            RtlCopyMemory(g_MicVSTBridge, data + first, bytes - first);
+
+        g_MicVSTBridgeWrite = (g_MicVSTBridgeWrite + bytes) % MICVST_BRIDGE_CAPACITY;
+        g_MicVSTBridgeAvailable += bytes;
+        KeReleaseSpinLock(&g_MicVSTBridgeLock, oldIrql);
+    }
+
+    static VOID MicVSTBridgePull(_Out_writes_bytes_(bytes) UCHAR* dest, _In_ ULONG bytes)
+    {
+        MicVSTBridgeEnsureInitialized();
+        if (dest == NULL || bytes == 0)
+            return;
+
+        ULONG copied = 0;
+        if (InterlockedCompareExchange(&g_MicVSTBridgeInitState, 2, 2) == 2)
+        {
+            KIRQL oldIrql;
+            KeAcquireSpinLock(&g_MicVSTBridgeLock, &oldIrql);
+            copied = min(bytes, g_MicVSTBridgeAvailable);
+            const ULONG first = min(copied, MICVST_BRIDGE_CAPACITY - g_MicVSTBridgeRead);
+            if (first > 0)
+                RtlCopyMemory(dest, g_MicVSTBridge + g_MicVSTBridgeRead, first);
+            if (copied > first)
+                RtlCopyMemory(dest + first, g_MicVSTBridge, copied - first);
+            g_MicVSTBridgeRead = (g_MicVSTBridgeRead + copied) % MICVST_BRIDGE_CAPACITY;
+            g_MicVSTBridgeAvailable -= copied;
+            KeReleaseSpinLock(&g_MicVSTBridgeLock, oldIrql);
+        }
+
+        if (copied < bytes)
+            RtlZeroMemory(dest + copied, bytes - copied);
+    }
+}
 
 #pragma warning (disable : 4127)
@@ -1264,6 +1337,10 @@ NTSTATUS CMiniportWaveRTStream::SetState
 
         case KSSTATE_RUN:
+            // A capture client may connect long after the MicVST render stream started.
+            // Discard stale buffered audio so a newly opened mic begins near real time.
+            if (m_bCapture)
+                MicVSTBridgeReset();
             // Start DMA
             LARGE_INTEGER ullPerfCounterTemp;
             ullPerfCounterTemp = KeQueryPerformanceCounter(&m_ullPerformanceCounterFrequency);
@@ -1379,11 +1456,8 @@ VOID CMiniportWaveRTStream::UpdatePosition
             m_bLastBufferRendered = TRUE;
         }
 
-        if (!g_DoNotCreateDataFiles)
-        {
-            // Read from buffer and write to a file.
-            ReadBytes(ByteDisplacement);
-        }
+        // Always route rendered audio into the MicVST bridge. ReadBytes itself
+        // decides whether the optional debug wave-file writer is enabled.
+        ReadBytes(ByteDisplacement);
     }
@@ -1415,8 +1489,7 @@ VOID CMiniportWaveRTStream::WriteBytes
     {
         ULONG runWrite = min(ByteDisplacement, m_ulDmaBufferSize - bufferOffset);
-        
-        // Instead of generating a tone, just output silence
-        RtlZeroMemory(m_pDmaBuffer + bufferOffset, runWrite);
+        MicVSTBridgePull(m_pDmaBuffer + bufferOffset, runWrite);
            	
         bufferOffset = (bufferOffset + runWrite) % m_ulDmaBufferSize;
@@ -1448,7 +1521,10 @@ VOID CMiniportWaveRTStream::ReadBytes
     while (ByteDisplacement > 0)
     {
         ULONG runWrite = min(ByteDisplacement, m_ulDmaBufferSize - bufferOffset);
-        m_SaveData.WriteData(m_pDmaBuffer + bufferOffset, runWrite);
+        MicVSTBridgePush(m_pDmaBuffer + bufferOffset, runWrite);
+        if (!g_DoNotCreateDataFiles)
+            m_SaveData.WriteData(m_pDmaBuffer + bufferOffset, runWrite);
+
         bufferOffset = (bufferOffset + runWrite) % m_ulDmaBufferSize;
         ByteDisplacement -= runWrite;
     }
